{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GSF Bridge",
  "identifier": "fr.gs4ever.bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GSF Bridge",
        "width": 640,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Bridge de la guilde Guild Self Forever",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": false,
    "publisher": "Ss7even",
    "copyright": "© 2026 Ss7even, MIT License",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyOUVBNTdDRDNGOTI5RjQKUldUMEtmblRmS1dlWW8wSlNGaEEvVEorT2tldTVKRFVFbkN1VFJjTmo4OXBEQlVHbG1NdWRISW4K",
      "endpoints": [
        "https://gsforever.com/api/v1/bridge/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
